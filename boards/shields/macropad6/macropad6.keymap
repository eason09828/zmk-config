/*
 * 6 键宏键盘 keymap
 *
 * 6 个按键 = 功能按钮（一按即触发动作，不用来打字）
 *   上排: 播放/暂停 | 上一曲 | 下一曲
 *   下排: 静音     | 截图   | 锁屏
 *
 * 旋钮 1: 顺时针 = 光标右移(→) / 逆时针 = 光标左移(←)  —— 文字输入左右
 * 旋钮 2: 顺时针 = 向下滚 / 逆时针 = 向上滚（鼠标滚轮，任何 App 都能滚）
 *
 * 改键有两种方式：
 *   1. 网页实时改（推荐）：USB 连 Mac → Chrome 打开 https://zmk.studio
 *      → 先按住 键1 + 键3 解锁 → 拖拽改键，即时生效、不用重新编译。
 *      注意：ZMK Studio 目前改不了旋钮，旋钮只能改本文件后重新编译。
 *   2. 改这个文件后重新编译刷入。
 */

/* 滚轮灵敏度：数值越大，转一格滚得越快（想慢下来就改小）。
 *
 * 数值含义 = 「每秒滚动多少格」。ZMK 的滚轮行为每 16ms 发一次事件，
 * 而 overlay 里的 steps 已校正为 80 → 「转 1 格 = 触发 1 次事件」，所以
 *   「转一格滚多少」≈ 本数值 × 0.016（取整后发出）。
 *
 *   10   → 0.16 格 → 取整 0 → 完全滚不动
 *   130  → 2 格（很细腻）
 *   200  → 3 格（约等于真鼠标一格滚轮）
 *   250  → 4 格
 *   350  → 5 格
 *   400  → 6 格
 *   500  → 8 格  ← 当前值（每转一格滚 8 行，慢速转动也能明显走起来）
 *   600  → 9 格（偏猛）
 *  1000  → 16 格（很快，慎用）
 *
 * 【为什么不能只让「慢转更灵敏」】每转一格的滚动量是固定的，转得快 = 单位时间
 *   滚得多 —— 和真实鼠标滚轮完全一样，属正常现象，不是故障。
 *   想让整体更快就加大这个数值，想更细腻就减小。
 *   若想让「慢转细腻、快转加速」，那属于系统侧的滚动加速曲线
 *   （Karabiner-Elements / macOS 记忆曲线），ZMK 端改不了。
 *
 * 必须在 include 之前定义，否则不生效。 */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 500

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ===== 第 0 层：日常使用 =====
         * 注意下排最左那颗是「轻按=静音，长按=进入调试层」 */
        default_layer {
            bindings = <
                &kp C_PLAY_PAUSE   &kp C_PREV               &kp C_NEXT
                &lt 1 C_MUTE       &kp LG(LS(NUMBER_4))     &kp LG(LC(Q))
            >;
            /* 旋钮 1 = 文字光标左右：顺时针 → 右移，逆时针 → 左移 */
            sensor-bindings = <&inc_dec_cursor RIGHT LEFT>,
                              <&inc_dec_scr SCRL_DOWN SCRL_UP>;
        };

        /* ===== 第 1 层：调试层（长按「静音」键期间生效）=====
         * 这层里两个旋钮都改成直接发字母，绕开滚轮参数，用来判断编码器本身好不好：
         *   长按静音键 + 转旋钮 1 → 打出 c / d
         *   长按静音键 + 转旋钮 2 → 打出 a / b
         * 判断标准是「转 1 格能不能打出 1 个字母」：
         *   1 格 1 个字母 → 编码器、接线、固件都正常
         *   要转 2 格才出 1 个 → overlay 里的 steps 与实际编码器不符（改那个值）
         *   完全打不出      → 那一路的硬件（A/B 虚焊、C 脚没接 GND）
         * 平时用不到这一层，长按「静音」键期间才生效。 */
        debug_layer {
            bindings = <
                &trans &trans &trans
                &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C D>,
                              <&inc_dec_kp A B>;
        };
    };

    /*
     * 让旋钮能驱动鼠标滚轮。
     * 官方自带的 &inc_dec_kp 只能发键盘按键，滚轮要用鼠标行为 &msc，
     * 所以照抄它的结构、把里面的 &kp 换成 &msc，做成一个
     * 「顺时针触发参数1、逆时针触发参数2」的传感器行为。
     */
    behaviors {
        /* 旋钮 1 用：顺时针/逆时针各触发一个键盘按键（这里接 ← →）。
         *
         * 为什么不直接用官方自带的 &inc_dec_kp：
         *   它的 tap-ms 是 5ms（官方 binding 里写死的默认值），
         *   5ms 的按下-松开实在太短，连续转动时偶发丢键。
         *   这里单独做一个 25ms 的版本，保证「转一格 = 稳稳一次 → 或 ←」。
         *   25ms 仍远小于系统判定「按住重复」的时间，不会变成按住连发。 */
        inc_dec_cursor: inc_dec_cursor {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tap-ms = <25>;
        };

        inc_dec_scr: inc_dec_scr {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            /* ！！！这个参数是旋钮能不能滚的关键！！！
             * &msc 每 16ms 才发一次滚轮事件，而 tap-ms 是「子行为按住多久」。
             * 默认 5ms —— 5ms 内就松开了，滚轮事件一次都发不出来，转旋钮毫无反应。
             * 必须设成 > 16ms，才能让第一次（也是唯一一次）滚轮事件发出去。
             * 25ms 既保证发得出去，又不会被误判成「按住不放」。 */
            tap-ms = <25>;
        };
    };

    /* 按住 键1 + 键3 同时按一下，解除 ZMK Studio 的写入锁 */
    combos {
        compatible = "zmk,combos";

        studio_unlock_combo {
            timeout-ms = <70>;
            key-positions = <0 2>;
            bindings = <&studio_unlock>;
        };
    };
};
