/*
 * 6 键宏键盘 keymap
 *
 * 6 个按键 = 功能按钮（一按即触发动作，不用来打字）
 *   上排: 播放/暂停 | 上一曲 | 下一曲
 *   下排: 静音     | 截图   | 锁屏
 *
 * 旋钮 1: 顺时针 = 音量加 / 逆时针 = 音量减
 * 旋钮 2: 顺时针 = 向下滚 / 逆时针 = 向上滚（鼠标滚轮，任何 App 都能滚）
 *
 * 改键有两种方式：
 *   1. 网页实时改（推荐）：USB 连 Mac → Chrome 打开 https://zmk.studio
 *      → 先按住 键1 + 键3 解锁 → 拖拽改键，即时生效、不用重新编译。
 *      注意：ZMK Studio 目前改不了旋钮，旋钮只能改本文件后重新编译。
 *   2. 改这个文件后重新编译刷入。
 */

/* 滚轮灵敏度：数值越大，转一格滚得越快（想慢下来就改小）。
 *
 * 数值含义 = 「每秒滚动多少格」。ZMK 的滚轮行为每 16ms 发一次事件，
 * 慢慢转的时候，每一格旋钮只会触发 1 次事件，所以
 *   慢转时「转一格滚多少」≈ 本数值 × 0.016（取整后发出）。
 *
 *   10  → 0.16 格 → 取整 0 → 完全滚不动（这就是最早失效的原因之一）
 *   200 → 3 格（上一版，慢转偏肉）
 *   300 → 4 格
 *   400 → 6 格
 *   600 → 9 格  ← 当前值，慢转也明显能滚
 *   800 → 12 格
 *  1000 → 16 格（很快，慎用）
 *
 * 【为什么快转总比慢转快】这是 ZMK 固件的固有特性，不是故障：
 *   连续快速转时，前一次还没松开、下一次就触发了，
 *   固件里的速度值是「累加」的（200 → 400 → 600…），
 *   而且定时器一直不停，于是每 16ms 就发一次、每次格数还翻倍。
 *   所以想让慢转更明显，唯一有效的办法就是把这个数字加大。
 *
 * 必须在 include 之前定义，否则不生效。 */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 600

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ===== 第 0 层：日常使用 =====
         * 注意下排最左那颗是「轻按=静音，长按=进入调试层」 */
        default_layer {
            bindings = <
                &kp C_PLAY_PAUSE   &kp C_PREV               &kp C_NEXT
                &lt 1 C_MUTE       &kp LG(LS(NUMBER_4))     &kp LG(LC(Q))
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_scr SCRL_DOWN SCRL_UP>;
        };

        /* ===== 第 1 层：调试层（长按「静音」键期间生效）=====
         * 这层里旋钮 2 改成发键盘字母 a / b，用来判断旋钮 2 的硬件到底有没有信号：
         * 长按静音键 + 转旋钮 2，如果能在能打字的地方打出 a / b，
         * 说明编码器和接线完全正常，问题只可能在固件。
         * 平时用不到这一层，长按键 4 才会进去。 */
        debug_layer {
            bindings = <
                &trans &trans &trans
                &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                              <&inc_dec_kp A B>;
        };
    };

    /*
     * 让旋钮能驱动鼠标滚轮。
     * 官方自带的 &inc_dec_kp 只能发键盘按键，滚轮要用鼠标行为 &msc，
     * 所以照抄它的结构、把里面的 &kp 换成 &msc，做成一个
     * 「顺时针触发参数1、逆时针触发参数2」的传感器行为。
     */
    behaviors {
        inc_dec_scr: inc_dec_scr {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            /* ！！！这个参数是旋钮能不能滚的关键！！！
             * &msc 每 16ms 才发一次滚轮事件，而 tap-ms 是「子行为按住多久」。
             * 默认 5ms —— 5ms 内就松开了，滚轮事件一次都发不出来，转旋钮毫无反应。
             * 必须设成 > 16ms，才能让第一次（也是唯一一次）滚轮事件发出去。
             * 25ms 既保证发得出去，又不会被误判成「按住不放」。 */
            tap-ms = <25>;
        };
    };

    /* 按住 键1 + 键3 同时按一下，解除 ZMK Studio 的写入锁 */
    combos {
        compatible = "zmk,combos";

        studio_unlock_combo {
            timeout-ms = <70>;
            key-positions = <0 2>;
            bindings = <&studio_unlock>;
        };
    };
};
